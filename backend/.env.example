NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Required in production. If omitted locally, Kyora starts with temporary in-memory data.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kyora
# Required for AI enhancement/moderation. Without it, a deterministic local fallback is used.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
VIDEO_PROVIDER=local
